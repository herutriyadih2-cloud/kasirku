<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Struk <%= transaction.invoice_number %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>
    @media print {
      .no-print { display: none !important; }
      body { margin: 0; padding: 0; background: #fff; }
    }
    body { background: #f1f5f9; font-family: 'Segoe UI', monospace; }
    .receipt { max-width: 80mm; margin: 40px auto; background: #fff; padding: 24px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    .line { border-top: 1px dashed #cbd5e1; margin: 12px 0; }
    .btn-print { border-radius: 12px; padding: 12px 24px; font-weight: 600; }
    .cap-print-modal { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 9999; padding: 16px; }
    .cap-print-modal-content { background: #fff; border-radius: 16px; padding: 20px; width: 100%; max-width: 360px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
  </style>
</head>
<body>
  <div class="no-print text-center py-4">
    <button onclick="window.print()" class="btn btn-primary btn-print me-2 mb-2"><i class="bi bi-printer"></i> Cetak Struk</button>
    <button id="btnNativePrint" class="btn btn-success btn-print me-2 mb-2 d-none"><i class="bi bi-printer-fill"></i> Cetak ke Printer</button>
    <a href="/transactions" class="btn btn-secondary btn-print mb-2"><i class="bi bi-arrow-left"></i> Kembali</a>
  </div>

  <script>
    window.PRINT_TX = {
      invoice_number: '<%= transaction.invoice_number %>',
      transaction_date: '<%= transaction.transaction_date %>',
      user_name: '<%= user ? user.name : "-" %>',
      employee_name: '<%= transaction.employee ? transaction.employee.name : "-" %>',
      customer_name: '<%= transaction.customer ? transaction.customer.name : "-" %>',
      customer_phone: '<%= transaction.customer && transaction.customer.phone ? transaction.customer.phone : "-" %>',
      estimated_finish_date: '<%= transaction.estimated_finish_date %>',
      weight: <%= transaction.weight || 0 %>,
      total: <%= transaction.total || 0 %>,
      discount: <%= transaction.discount || 0 %>,
      paid_amount: <%= transaction.paid_amount || 0 %>,
      change_amount: <%= transaction.change_amount || 0 %>,
      payment_method: '<%= transaction.payment_method || "" %>',
      laundry_status: '<%= transaction.laundry_status || "" %>',
      items: [
        <% transaction.items.forEach((item, idx) => { %>
        {
          product_name: '<%= item.product.name.replace(/'/g, "\\'") %>',
          quantity: <%= item.quantity %>,
          sale_price_at_time: <%= item.sale_price_at_time %>,
          subtotal: <%= item.subtotal %>,
          discount: <%= item.discount || 0 %>
        }<%= idx < transaction.items.length - 1 ? ',' : '' %>
        <% }) %>
      ]
    };
  </script>
  <script src="/js/capacitor-print.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const btn = document.getElementById('btnNativePrint');
      if (window.CAP_PRINT && window.CAP_PRINT.isNative && window.CAP_PRINT.isNative()) {
        btn.classList.remove('d-none');
        const platform = window.CAP_PRINT.getPlatform();
        if (platform === 'ios-native') {
          btn.innerHTML = '<i class="bi bi-printer-fill"></i> Cetak (AirPrint)';
        } else {
          btn.innerHTML = '<i class="bi bi-bluetooth"></i> Cetak Bluetooth';
        }
        btn.addEventListener('click', function() {
          window.CAP_PRINT.printTransaction(window.PRINT_TX);
        });
      }
    });
  </script>

  <div class="receipt">
    <div class="text-center">
      <img src="/images/logo.jpg" alt="Laundry Suarni" style="max-width: 80px; margin-bottom: 8px; border-radius: 8px;">
      <h5 class="fw-bold">Laundry Suarni</h5>
      <p class="text-muted mb-1" style="font-size: 0.75rem;">Biar Kami yang Cuci, Kamu Fokus Raih Mimpi.</p>
      <p class="text-muted mb-1" style="font-size: 0.75rem;">Jl. Contoh No. 123</p>
      <p class="text-muted" style="font-size: 0.75rem;">Telp: 08123456789</p>
    </div>
    <div class="line"></div>
    <p style="font-size: 0.85rem;">
      No Order: <%= transaction.invoice_number %><br>
      Tgl: <%= new Date(transaction.transaction_date).toLocaleString('id-ID') %><br>
      Kasir: <%= user ? user.name : '-' %><br>
      Petugas: <%= transaction.employee ? transaction.employee.name : '-' %><br>
      Pelanggan: <%= transaction.customer ? transaction.customer.name : '-' %><br>
      <% if (transaction.customer && transaction.customer.phone) { %>Telp: <%= transaction.customer.phone %><br><% } %>
      Estimasi Selesai: <%= transaction.estimated_finish_date ? new Date(transaction.estimated_finish_date).toLocaleDateString('id-ID') : '-' %>
    </p>
    <div class="line"></div>
    <% transaction.items.forEach(item => { %>
      <div style="font-size: 0.85rem; margin-bottom: 8px;">
        <div class="fw-semibold"><%= item.product.name %></div>
        <div class="d-flex justify-content-between">
          <span><%= item.quantity %> x Rp <%= Number(item.sale_price_at_time).toLocaleString('id-ID') %></span>
          <span>Rp <%= Number(item.subtotal).toLocaleString('id-ID') %></span>
        </div>
        <% if (item.discount > 0) { %>
          <div class="text-danger" style="font-size: 0.75rem;">Diskon: Rp <%= Number(item.discount).toLocaleString('id-ID') %></div>
        <% } %>
      </div>
    <% }) %>
    <% if (transaction.weight > 0) { %>
      <div class="d-flex justify-content-between" style="font-size: 0.85rem;">
        <span>Berat Total</span>
        <span><%= transaction.weight %> kg</span>
      </div>
    <% } %>
    <div class="line"></div>
    <div class="d-flex justify-content-between" style="font-size: 0.85rem;">
      <span>Subtotal</span>
      <span>Rp <%= Number(transaction.total + parseFloat(transaction.discount)).toLocaleString('id-ID') %></span>
    </div>
    <% if (transaction.discount > 0) { %>
      <div class="d-flex justify-content-between" style="font-size: 0.85rem;">
        <span>Diskon</span>
        <span>Rp <%= Number(transaction.discount).toLocaleString('id-ID') %></span>
      </div>
    <% } %>
    <div class="d-flex justify-content-between fw-bold mt-2" style="font-size: 0.95rem;">
      <span>TOTAL</span>
      <span>Rp <%= Number(transaction.total).toLocaleString('id-ID') %></span>
    </div>
    <div class="d-flex justify-content-between mt-2" style="font-size: 0.85rem;">
      <span>Bayar</span>
      <span>Rp <%= Number(transaction.paid_amount).toLocaleString('id-ID') %></span>
    </div>
    <div class="d-flex justify-content-between" style="font-size: 0.85rem;">
      <span>Kembalian</span>
      <span>Rp <%= Number(transaction.change_amount).toLocaleString('id-ID') %></span>
    </div>
    <div class="d-flex justify-content-between" style="font-size: 0.85rem;">
      <span>Metode</span>
      <span><%= transaction.payment_method.toUpperCase() %></span>
    </div>
    <div class="line"></div>
    <div class="text-center">
      <span class="badge bg-primary mb-2">
        <% const ls = { received: 'DITERIMA', washing: 'DICUCI', ironing: 'DISETRIKA', ready: 'SIAP AMBIL', completed: 'SELESAI', canceled: 'DIBATALKAN' }; %>
        <%= ls[transaction.laundry_status] %>
      </span>
    </div>
    <p class="text-center text-muted mb-0" style="font-size: 0.75rem;">Terima kasih telah mempercayakan cucian Anda!</p>
  </div>
</body>
</html>
