<%- include('../partials/header', { title: 'Pengeluaran' }) %>
<%- include('../partials/navbar') %>

<div class="app-wrapper">
  <div class="main-content">
    <%- include('../partials/topbar', { title: 'Pengeluaran' }) %>

    <div class="page-content">
      <div class="card-santai mb-4">
        <div class="card-body">
          <h5 class="fw-bold mb-3"><i class="bi bi-funnel text-primary me-2"></i>Filter & Tambah Pengeluaran</h5>
          <form method="GET" class="row g-2 mb-4">
            <div class="col-md-4"><input type="date" name="start" class="form-control" value="<%= start %>"></div>
            <div class="col-md-4"><input type="date" name="end" class="form-control" value="<%= end %>"></div>
            <div class="col-md-4"><button class="btn btn-outline-santai btn-santai w-100"><i class="bi bi-filter"></i> Filter</button></div>
          </form>
          <form method="POST" action="/expenses" class="row g-2">
            <div class="col-md-4"><input type="text" name="description" class="form-control" placeholder="Keterangan" required></div>
            <div class="col-md-2"><input type="number" name="amount" class="form-control" placeholder="Jumlah" required></div>
            <div class="col-md-2"><input type="text" name="category" class="form-control" placeholder="Kategori"></div>
            <div class="col-md-3"><input type="date" name="date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required></div>
            <div class="col-md-1"><button class="btn btn-primary-santai btn-santai w-100"><i class="bi bi-plus-lg"></i></button></div>
          </form>
        </div>
      </div>

      <div class="card-santai">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-wallet2 text-primary me-2"></i>Daftar Pengeluaran</h5>
            <span class="badge-santai bg-soft-danger text-danger">Total: Rp <%= Number(total).toLocaleString('id-ID') %></span>
          </div>
          <div class="table-responsive">
            <table class="table-santai">
              <thead><tr><th>Tanggal</th><th>Keterangan</th><th>Kategori</th><th>Jumlah</th><th class="text-end">Aksi</th></tr></thead>
              <tbody>
                <% expenses.forEach(e => { %>
                  <tr>
                    <td><%= new Date(e.date).toLocaleDateString('id-ID') %></td>
                    <td class="fw-semibold"><%= e.description %></td>
                    <td><%= e.category || '-' %></td>
                    <td>Rp <%= Number(e.amount).toLocaleString('id-ID') %></td>
                    <td class="text-end">
                      <button class="btn btn-sm btn-warning text-white" data-bs-toggle="modal" data-bs-target="#editModal<%= e.id %>"><i class="bi bi-pencil"></i></button>
                      <form method="POST" action="/expenses/<%= e.id %>/delete" class="d-inline" onsubmit="return confirm('Hapus pengeluaran ini?')">
                        <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                      </form>
                    </td>
                  </tr>
                  <div class="modal fade" id="editModal<%= e.id %>">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content border-0 shadow" style="border-radius: 16px;">
                        <form method="POST" action="/expenses/<%= e.id %>/update">
                          <div class="modal-header border-0"><h5 class="modal-title fw-bold">Edit Pengeluaran</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                          <div class="modal-body">
                            <label class="form-label">Keterangan</label><input type="text" name="description" class="form-control mb-3" value="<%= e.description %>" required>
                            <label class="form-label">Jumlah</label><input type="number" name="amount" class="form-control mb-3" value="<%= e.amount %>" required>
                            <label class="form-label">Kategori</label><input type="text" name="category" class="form-control mb-3" value="<%= e.category %>">
                            <label class="form-label">Tanggal</label><input type="date" name="date" class="form-control" value="<%= e.date.toISOString ? e.date.toISOString().split('T')[0] : e.date %>" required>
                          </div>
                          <div class="modal-footer border-0"><button class="btn btn-primary-santai btn-santai">Simpan</button></div>
                        </form>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
