<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Error</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background: #f1f5f9; }
    .error-card { max-width: 520px; margin: 80px auto; background: #fff; border-radius: 24px; padding: 48px; box-shadow: 0 10px 40px rgba(0,0,0,0.08); text-align: center; }
    .error-icon { width: 80px; height: 80px; background: #fff1f2; color: #ef476f; border-radius: 24px; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 24px; }
  </style>
</head>
<body>
  <div class="error-card">
    <div class="error-icon"><i class="bi bi-exclamation-circle"></i></div>
    <h2 class="fw-bold mb-2">Oops!</h2>
    <p class="text-muted mb-4"><%= message %></p>
    <a href="/dashboard" class="btn btn-primary px-4 py-2" style="border-radius: 12px; background: linear-gradient(135deg, #4361ee, #7c3aed); border: none;"><i class="bi bi-arrow-left me-2"></i>Kembali ke Dashboard</a>
  </div>
</body>
</html>
