<%- include('partials/header', { title: 'Pengaturan Printer' }) %>
<%- include('partials/navbar') %>

<div class="app-wrapper">
  <div class="main-content">
    <%- include('partials/topbar', { title: 'Pengaturan Printer' }) %>

    <div class="page-content">
      <div class="page-header">
        <h2>Pengaturan Printer</h2>
        <p>Test koneksi printer Bluetooth thermal</p>
      </div>

      <div class="row g-3">
        <div class="col-lg-6">
          <div class="card-santai">
            <div class="card-body">
              <h5 class="fw-bold mb-3"><i class="bi bi-bluetooth text-primary me-2"></i>Status Koneksi</h5>
              <div id="printerStatus">
                <div class="alert alert-info">Memeriksa environment...</div>
              </div>
              <div class="d-grid gap-2 mt-3">
                <button id="btnRefreshStatus" class="btn btn-outline-santai btn-santai"><i class="bi bi-arrow-clockwise"></i> Refresh Status</button>
                <button id="btnOpenBtSettings" class="btn btn-secondary btn-santai d-none"><i class="bi bi-gear"></i> Buka Pengaturan Bluetooth</button>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="card-santai">
            <div class="card-body">
              <h5 class="fw-bold mb-3"><i class="bi bi-search text-primary me-2"></i>Cari Printer</h5>
              <p class="text-muted small">Pastikan printer sudah menyala dan dalam jangkauan HP.</p>
              <button id="btnScanPrinter" class="btn btn-primary-santai btn-santai w-100 mb-3"><i class="bi bi-search"></i> Scan Printer</button>
              <div id="scanResult"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="card-santai mt-4">
        <div class="card-body">
          <h5 class="fw-bold mb-3"><i class="bi bi-bug text-primary me-2"></i>Log / Informasi</h5>
          <pre id="printerLog" class="bg-dark text-light p-3 rounded" style="min-height: 150px; max-height: 300px; overflow-y: auto; font-size: 0.8rem;"></pre>
          <button id="btnClearLog" class="btn btn-sm btn-secondary">Bersihkan Log</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/capacitor-print.js"></script>
<script>
  const logEl = document.getElementById('printerLog');
  const statusEl = document.getElementById('printerStatus');
  const scanResultEl = document.getElementById('scanResult');

  function log(msg) {
    const time = new Date().toLocaleTimeString('id-ID');
    logEl.textContent += `[${time}] ${msg}\n`;
    logEl.scrollTop = logEl.scrollHeight;
  }

  function setStatus(html, type) {
    statusEl.innerHTML = `<div class="alert alert-${type}">${html}</div>`;
  }

  function checkStatus() {
    if (!window.CAP_PRINT) {
      setStatus('CAP_PRINT tidak ditemukan. Pastikan aplikasi dibuka dari APK Android.', 'danger');
      log('ERROR: CAP_PRINT tidak ditemukan');
      return;
    }

    const platform = window.CAP_PRINT.getPlatform();
    log('Platform terdeteksi: ' + platform);

    if (platform === 'android-native') {
      setStatus('Aplikasi Android native terdeteksi. Siap scan printer.', 'success');
      document.getElementById('btnOpenBtSettings').classList.remove('d-none');
      window.CAP_PRINT.isBluetoothEnabled()
        .then(() => log('Bluetooth: ON'))
        .catch(err => log('Bluetooth: OFF / ' + err));
    } else if (platform === 'ios-native') {
      setStatus('iOS native terdeteksi. Gunakan AirPrint/native print dialog.', 'info');
    } else {
      setStatus('Anda membuka dari browser/web. Fitur Bluetooth printer hanya tersedia di APK Android.', 'warning');
      log('WARNING: Bukan native app');
    }
  }

  document.getElementById('btnRefreshStatus').addEventListener('click', checkStatus);

  document.getElementById('btnOpenBtSettings').addEventListener('click', () => {
    window.CAP_PRINT.showBluetoothSettings()
      .then(() => log('Pengaturan Bluetooth dibuka'))
      .catch(err => log('Gagal buka pengaturan: ' + err));
  });

  document.getElementById('btnClearLog').addEventListener('click', () => {
    logEl.textContent = '';
  });

  document.getElementById('btnScanPrinter').addEventListener('click', async () => {
    scanResultEl.innerHTML = '<div class="text-center"><div class="spinner-border text-primary"></div><p class="mt-2">Mencari printer...</p></div>';
    log('Memulai scan printer...');
    try {
      const devices = await window.CAP_PRINT.scanDevices();
      log('Ditemukan ' + devices.length + ' perangkat');
      if (devices.length === 0) {
        scanResultEl.innerHTML = '<div class="alert alert-warning">Tidak ada printer ditemukan. Coba pairing manual di pengaturan Bluetooth.</div>';
        return;
      }

      let html = '<div class="list-group">';
      devices.forEach(d => {
        html += `
          <div class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <div class="fw-semibold">${d.name || 'Unknown'}</div>
              <small class="text-muted">${d.address}</small>
            </div>
            <button class="btn btn-sm btn-success btn-test-print" data-mac="${d.address}"><i class="bi bi-printer"></i> Test Print</button>
          </div>
        `;
      });
      html += '</div>';
      scanResultEl.innerHTML = html;

      document.querySelectorAll('.btn-test-print').forEach(btn => {
        btn.addEventListener('click', async () => {
          const mac = btn.dataset.mac;
          log('Menghubungkan ke ' + mac + '...');
          try {
            await window.CAP_PRINT.connectPrinter(mac);
            log('Berhasil konek ke ' + mac);
            await window.CAP_PRINT.testPrint(mac);
            log('Test print terkirim');
            alert('Test print berhasil dikirim!');
            await window.CAP_PRINT.disconnectSPP(mac);
          } catch (err) {
            log('ERROR: ' + err.message);
            alert('Gagal: ' + err.message);
          }
        });
      });
    } catch (err) {
      log('ERROR scan: ' + err.message);
      scanResultEl.innerHTML = '<div class="alert alert-danger">Gagal scan: ' + err.message + '</div>';
    }
  });

  // Initial check
  setTimeout(checkStatus, 500);
</script>

<%- include('partials/footer') %>
